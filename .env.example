# Порты на хосте (грейдер ходит на 5000 и 5001; локально на Mac 5000 может быть занят AirPlay)
RECS_PORT=5001
EVENT_COLLECTOR_PORT=5000
# Воркеры uvicorn: несколько процессов убирают хвост латентности при 50 параллельных пользователях
RECS_WORKERS=2
EVENT_COLLECTOR_WORKERS=2

# Адреса инфраструктуры (внутри docker compose имена сервисов)
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=interactions

# Формат ответа /recs: dict -> {"user_id": ..., "recs": [...], "items": [...], ...}; list -> [id, id, ...]
RECS_RESPONSE_FORMAT=dict
TOP_K=10

# Гибридный скоринг
CTR_PRIOR_STRENGTH=10.0
W_POP=1.0
W_CONTENT=0.4
W_CF=0.3
W_EXPLORE=0.1
DISLIKE_WEIGHT=0.5
MMR_LAMBDA=0.9
N_EXPLORE=1
N_CANDIDATES=200

# Pipeline (ALS)
TRAIN_INTERVAL_SEC=60
MIN_LIKES_TO_TRAIN=50
ALS_FACTORS=32
ALS_ITERATIONS=10
ALS_REG=0.1
ALS_ALPHA=10.0
CF_TOP_N=50

# Сколько первых сырых тел запросов писать в лог (диагностика формата грейдера)
LOG_RAW_REQUESTS=20
